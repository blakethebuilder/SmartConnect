# Copy to .env and fill in. .env is gitignored.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-strong

# AI intent detection (optional — keyword fallback when empty)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Netcash Pay Now (required for payment webhook verification — fails closed without it)
NETCASH_SERVICE_ID=
NETCASH_HASH_KEY=

# Public URL of the web service (used in Netcash Notify callback URLs)
PUBLIC_BASE_URL=http://localhost:8080
